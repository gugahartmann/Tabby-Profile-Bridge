{
  "name": "tabby-profile-bridge",
  "version": "0.1.0",
  "description": "Import and export Tabby SSH/Telnet profiles and nested folders using safe CSV exchange",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "terminal",
    "ssh",
    "telnet",
    "csv",
    "profile-import",
    "profile-export",
    "mobaxterm",
    "profile-manager"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "webpack --mode production",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@angular/core": "^15.0.0",
    "@angular/common": "^15.0.0",
    "@angular/forms": "^15.0.0",
    "@ng-bootstrap/ng-bootstrap": "^14.0.0",
    "@types/node": "^18.0.0",
    "apply-loader": "^2.0.0",
    "pug": "^3.0.0",
    "pug-loader": "^2.4.0",
    "ts-loader": "^9.5.0",
    "typescript": "~4.9.5",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "tabby-core": "^1.0.231-nightly.0",
    "tabby-settings": "^1.0.231-nightly.0"
  },
  "author": "gugahartmann",
  "repository": {
    "type": "git",
    "url": "https://github.com/gugahartmann/Tabby-Profile-Bridge.git"
  },
  "homepage": "https://github.com/gugahartmann/Tabby-Profile-Bridge#readme",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gugahartmann/Tabby-Profile-Bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  }
